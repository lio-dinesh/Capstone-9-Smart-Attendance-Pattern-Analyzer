# Backend Configuration
PROJECT_NAME="Smart Attendance Pattern Analyzer"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (SQLite by default; compatible with PostgreSQL)
DATABASE_URL="sqlite:///./backend/attendance.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/attendance_db"

# Attendance Calculation Parameters
LATE_ATTENDANCE_WEIGHT=1.0
EXCLUDE_EXCUSED_FROM_DENOMINATOR=True
PROVISIONAL_COMPLETENESS_THRESHOLD_PCT=85.0

# Anomaly Rule Thresholds
CONSECUTIVE_ABSENCE_THRESHOLD=3
ATTENDANCE_DROP_THRESHOLD_PCT=15.0
BASELINE_WEEKS=4
CURRENT_WINDOW_WEEKS=2
MIN_SESSIONS_FOR_DROP_ANALYSIS=4
MISSING_RECORD_THRESHOLD_PCT=10.0

# Frontend Configuration
VITE_API_URL="http://127.0.0.1:8000"
